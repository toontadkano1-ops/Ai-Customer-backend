# CX Intelligence Backend Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Authentication Secrets
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_for_security!
JWT_EXPIRES_IN=7d

# Supabase Configuration (Leave empty to use built-in offline multi-tenant storage)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI Provider Configuration
# Set to 'mock' for self-contained zero-config mode, or 'gemini' / 'openai'
AI_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_MODEL_NAME=gemini-1.5-flash

# Chatbot Grounding Configuration
CONFIDENCE_THRESHOLD=0.65
AUTO_ESCALATION_SENTIMENT_THRESHOLD=-0.6
